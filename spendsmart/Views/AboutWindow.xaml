<Window x:Class="spendsmart.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Team"
        Height="720"
        Width="480"
        WindowStartupLocation="CenterOwner"
        Background="White"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#159CE4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0F8FD4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0B7FBE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="16,0">
            <Button Content="‹"
                    Click="Back_Click"
                    Width="34"
                    Height="34"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#159CE4"
                    FontSize="28"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
            <TextBlock Text="About Team"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#555555"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,18">
                <StackPanel Margin="0,4,0,18"
                            HorizontalAlignment="Center">
                    <TextBlock Text="NHÓM 1"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#159CE4"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="App quản lý chi tiêu"
                               FontSize="18"
                               FontWeight="Black"
                               Foreground="#333333"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Thành viên nhóm"
                               Style="{StaticResource SectionTitleStyle}" />
                    <DataGrid x:Name="dgMembers"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="30"
                              ColumnHeaderHeight="30"
                              BorderBrush="#DADADA"
                              BorderThickness="1"
                              Background="White"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã SV"
                                                Binding="{Binding MaSV}"
                                                Width="78" />
                            <DataGridTextColumn Header="Họ và tên"
                                                Binding="{Binding Ten}"
                                                Width="130" />
                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Ảnh tập thể nhóm"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Border Height="190"
                            Background="#EEF8FE"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Image Source="/hihi.jpg"
                               Stretch="UniformToFill" />
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Video giới thiệu sản phẩm"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Border Background="Black"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Height="190"
                            Margin="0,0,0,12">
                        <MediaElement x:Name="myMedia"
                                      Source="0212.mp4"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Play"
                                Click="Play_Click"
                                Style="{StaticResource MediaButtonStyle}" />
                        <Button Content="Pause"
                                Click="Pause_Click"
                                Style="{StaticResource MediaButtonStyle}" />
                        <Button Content="Stop"
                                Click="Stop_Click"
                                Style="{StaticResource MediaButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
