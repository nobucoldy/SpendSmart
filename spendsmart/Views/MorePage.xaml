<UserControl x:Class="spendsmart.Views.MorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADADA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F7FBFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,0">
            <TextBlock Text="Khác"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#555"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1">
            <Border BorderBrush="#DADADA"
                    BorderThickness="0,1,0,1"
                    Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            Background="#EEF8FE"
                            CornerRadius="18">
                        <TextBlock Text="👤"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding FullName}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#555"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Email}"
                                   FontSize="12"
                                   Foreground="#999"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button Command="{Binding ShowBudgetCommand}"
                    Style="{StaticResource MenuButtonStyle}">
                <DockPanel>
                    <TextBlock Text="🎯  Ngân sách"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#555" />
                    <TextBlock Text="›"
                               FontSize="20"
                               Foreground="#AAA"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </Button>

            <Button Command="{Binding ShowAboutCommand}"
                    Style="{StaticResource MenuButtonStyle}">
                <DockPanel>
                    <TextBlock Text="ⓘ  About Team"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#555" />
                    <TextBlock Text="›"
                               FontSize="20"
                               Foreground="#AAA"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </Button>

            <Button Command="{Binding LogoutCommand}"
                    Style="{StaticResource MenuButtonStyle}">
                <DockPanel>
                    <TextBlock Text="↩  Đăng xuất"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#F0533F" />
                    <TextBlock Text="›"
                               FontSize="20"
                               Foreground="#AAA"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
