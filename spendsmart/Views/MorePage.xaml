<UserControl x:Class="spendsmart.Views.MorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,8,20,0">
            <TextBlock Text="22:02" FontSize="22" FontWeight="Bold" VerticalAlignment="Top" />
            <TextBlock Text="Khác" FontSize="24" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <Border BorderBrush="#DADADA" BorderThickness="0,1,0,1" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" Background="#EEF8FE" CornerRadius="23">
                        <TextBlock Text="👤" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Người dùng SpendSmart" FontSize="22" FontWeight="Bold" Foreground="#555" />
                        <TextBlock Text="Thông tin tài khoản" FontSize="16" Foreground="#999" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border BorderBrush="#DADADA" BorderThickness="0,0,0,1" Padding="24,16">
                <DockPanel>
                    <TextBlock Text="□  Quản lý danh mục" FontSize="22" FontWeight="SemiBold" Foreground="#555" />
                    <TextBlock Text="›" FontSize="32" Foreground="#AAA" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
            <Border BorderBrush="#DADADA" BorderThickness="0,0,0,1" Padding="24,16">
                <DockPanel>
                    <TextBlock Text="ⓘ  Về ứng dụng" FontSize="22" FontWeight="SemiBold" Foreground="#555" />
                    <TextBlock Text="›" FontSize="32" Foreground="#AAA" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
            <Border BorderBrush="#DADADA" BorderThickness="0,0,0,1" Padding="24,16">
                <DockPanel>
                    <TextBlock Text="↩  Đăng xuất" FontSize="22" FontWeight="SemiBold" Foreground="#F0533F" />
                    <TextBlock Text="›" FontSize="32" Foreground="#AAA" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
