<UserControl x:Class="spendsmart.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,8,20,0">
            <TextBlock Text="22:02" FontSize="22" FontWeight="Bold" VerticalAlignment="Top" />
            <TextBlock Text="▣" FontSize="32" Foreground="#419CDF" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <TextBlock Text="⌕" FontSize="38" Foreground="#419CDF" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            <Border Width="250" Height="38" Background="#E8E8EA" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Margin="2" Background="#419CDF" CornerRadius="10">
                        <TextBlock Text="Hàng Tháng" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Hàng Năm" Foreground="#419CDF" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border BorderBrush="#DADADA" BorderThickness="0,1,0,0" Padding="18,12">
                <Grid>
                    <TextBlock Text="‹" FontSize="34" Foreground="#555" HorizontalAlignment="Left" />
                    <Border Width="398" Height="42" Background="#EEF8FE" CornerRadius="8" HorizontalAlignment="Center">
                        <TextBlock Text="06/2026  (01/06–30/06)" FontSize="25" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="›" FontSize="34" Foreground="#555" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Grid Margin="24,12,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <DockPanel>
                        <TextBlock Text="Chi tiêu" FontSize="16" Foreground="#666" />
                        <TextBlock Text="-1,904,000đ" FontSize="21" FontWeight="Bold" Foreground="#F26B5A" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <DockPanel>
                        <TextBlock Text="Thu nhập" FontSize="16" Foreground="#666" />
                        <TextBlock Text="+0đ" FontSize="21" FontWeight="Bold" Foreground="#419CDF" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>
            </Grid>
            <Border Margin="24,0,24,18" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <DockPanel>
                    <TextBlock Text="Thu chi" FontSize="16" Foreground="#666" />
                    <TextBlock Text="-1,904,000đ" FontSize="23" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Grid Margin="24,0,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Chi tiêu" FontSize="20" Foreground="#419CDF" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Thu nhập" FontSize="20" Foreground="#D8D8D8" HorizontalAlignment="Center" />
            </Grid>
            <Grid Width="250" Height="250" HorizontalAlignment="Center">
                <Ellipse Stroke="#FF8B22" StrokeThickness="48" />
                <Ellipse Width="158" Height="158" Fill="White" />
                <TextBlock Text="Ăn uống" FontSize="18" Foreground="White" Margin="130,52,0,0" />
                <TextBlock Text="Lặt vặt" FontSize="18" Foreground="White" Margin="138,166,0,0" />
                <TextBlock Text="Xăng dầu" FontSize="18" Foreground="White" Margin="8,150,0,0" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <Border BorderBrush="#DADADA" BorderThickness="0,1,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🍽" FontSize="24" />
                    <TextBlock Grid.Column="1" Text="Ăn uống" FontSize="24" FontWeight="Bold" Foreground="#555" />
                    <TextBlock Grid.Column="2" Text="302,000đ" FontSize="22" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="15.9 %" FontSize="18" Foreground="#666" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="›" FontSize="34" Foreground="#AAA" />
                </Grid>
            </Border>
            <Border BorderBrush="#DADADA" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="👕" FontSize="24" />
                    <TextBlock Grid.Column="1" Text="Quần áo" FontSize="24" FontWeight="Bold" Foreground="#555" />
                    <TextBlock Grid.Column="2" Text="90,000đ" FontSize="22" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="4.7 %" FontSize="18" Foreground="#666" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="›" FontSize="34" Foreground="#AAA" />
                </Grid>
            </Border>
            <Border BorderBrush="#DADADA" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🛒" FontSize="24" />
                    <TextBlock Grid.Column="1" Text="Lặt vặt" FontSize="24" FontWeight="Bold" Foreground="#555" />
                    <TextBlock Grid.Column="2" Text="452,000đ" FontSize="22" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="23.7 %" FontSize="18" Foreground="#666" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="›" FontSize="34" Foreground="#AAA" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
