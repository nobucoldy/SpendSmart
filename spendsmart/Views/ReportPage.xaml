<UserControl x:Class="spendsmart.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <Style x:Key="ReportTabStyle" TargetType="RadioButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Border x:Name="Underline"
                                    Height="2"
                                    Background="Transparent"
                                    VerticalAlignment="Bottom" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#419CDF" />
                                <Setter TargetName="Underline" Property="Background" Value="#419CDF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,4,20,0">
                        
            <Border Width="210"
                    Height="32"
                    Background="#E8E8EA"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Margin="2"
                            Background="#419CDF"
                            CornerRadius="10">
                        <TextBlock Text="Hàng tháng"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Hàng năm"
                               Foreground="#419CDF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel>
                <Border BorderBrush="#DADADA"
                        BorderThickness="0,1,0,0"
                        Padding="16,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Button Content="&lt;"
                                Command="{Binding PreviousMonthCommand}"
                                Width="30"
                                Height="30"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#555"
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Left" />
                        <Border Grid.Column="1"
                                Height="30"
                                Background="#EEF8FE"
                                CornerRadius="8">
                            <TextBlock Text="{Binding MonthText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#555"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="2"
                                Content="&gt;"
                                Command="{Binding NextMonthCommand}"
                                Width="30"
                                Height="30"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#555"
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Grid Margin="16,8,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6">
                        <DockPanel>
                            <TextBlock Text="Chi tiêu"
                                       FontSize="12"
                                       Foreground="#666" />
                            <TextBlock Text="{Binding TotalExpenseText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#F26B5A"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6">
                        <DockPanel>
                            <TextBlock Text="Thu nhập"
                                       FontSize="12"
                                       Foreground="#666" />
                            <TextBlock Text="{Binding TotalIncomeText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#419CDF"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                </Grid>
                <Border Margin="16,0,16,10"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6">
                    <DockPanel>
                        <TextBlock Text="Thu chi"
                                   FontSize="12"
                                   Foreground="#666" />
                        <TextBlock Text="{Binding BalanceText}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#555"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>

                <Grid Margin="24,0,24,6" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Chi tiêu"
                                 IsChecked="{Binding IsExpenseSelected, Mode=OneWay}"
                                 Command="{Binding ShowExpenseCommand}"
                                 Style="{StaticResource ReportTabStyle}" />
                    <RadioButton Grid.Column="1"
                                 Content="Thu nhập"
                                 IsChecked="{Binding IsIncomeSelected, Mode=OneWay}"
                                 Command="{Binding ShowIncomeCommand}"
                                 Style="{StaticResource ReportTabStyle}" />
                </Grid>

                <Grid Width="220"
                      Height="180"
                      HorizontalAlignment="Center">
                    <TextBlock Text="{Binding EmptyMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="#999"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <lvc:PieChart Series="{Binding ChartSeries}"
                                  LegendPosition="Hidden"
                                  TooltipPosition="Hidden"
                                  InitialRotation="-90" />
                </Grid>

                <ItemsControl ItemsSource="{Binding CategoryItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DADADA"
                                    BorderThickness="0,1,0,0"
                            Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="17"
                                               Foreground="{Binding Color}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CategoryName}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#555"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotalAmountText}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#555"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding PercentageText}"
                                               FontSize="12"
                                               Foreground="#666"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
