<Window x:Class="spendsmart.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpendSmart - Register"
        Width="480"
        Height="850"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FB">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
                Padding="28"
                Background="White"
                CornerRadius="18">
            <StackPanel>
                <TextBlock Text="Create Account"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Start tracking your money"
                           Margin="0,8,0,28"
                           FontSize="15"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Full Name"
                           FontWeight="SemiBold"
                           Foreground="#374151" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,8,0,16"
                         Height="44"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         FontSize="15" />

                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Foreground="#374151" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,8,0,16"
                         Height="44"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         FontSize="15" />

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="#374151" />
                <PasswordBox x:Name="PasswordInput"
                             Margin="0,8,0,16"
                             Height="44"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="15"
                             PasswordChanged="PasswordInput_PasswordChanged" />

                <TextBlock Text="Confirm Password"
                           FontWeight="SemiBold"
                           Foreground="#374151" />
                <PasswordBox x:Name="ConfirmPasswordInput"
                             Margin="0,8,0,16"
                             Height="44"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="15"
                             PasswordChanged="ConfirmPasswordInput_PasswordChanged" />

                <TextBlock Text="{Binding ErrorMessage}"
                           MinHeight="24"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Foreground="#DC2626" />

                <Button Content="Register"
                        Command="{Binding RegisterCommand}"
                        Height="46"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="SemiBold"
                        BorderThickness="0" />

                <Button Content="Back to login"
                        Command="{Binding OpenLoginCommand}"
                        Margin="0,14,0,0"
                        Height="42"
                        Background="Transparent"
                        Foreground="#2563EB"
                        FontWeight="SemiBold"
                        BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
