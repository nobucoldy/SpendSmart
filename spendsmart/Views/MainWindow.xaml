<Window x:Class="spendsmart.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpendSmart"
        Width="500"
        Height="900"
        MinWidth="500"
        MinHeight="900"
        MaxWidth="500"
        MaxHeight="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FB">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Margin="4"
                                Padding="6"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF1FF" />
                                <Setter Property="Foreground" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="White"
            CornerRadius="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24,22,24,18"
                    BorderBrush="#EEF2F7"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="SpendSmart"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#111827" />
                    <TextBlock Text="{Binding SelectedTab}"
                               Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="#6B7280" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}" />

            <Border Grid.Row="2"
                    Padding="10,8,10,10"
                    Background="White"
                    BorderBrush="#EEF2F7"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,24,24">
                <UniformGrid Columns="5">
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsInputSelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Input">
                        <StackPanel>
                            <TextBlock Text="+"
                                       FontSize="22"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Input"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsHistorySelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="History">
                        <StackPanel>
                            <TextBlock Text="H"
                                       FontSize="18"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="History"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsReportsSelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Reports">
                        <StackPanel>
                            <TextBlock Text="%"
                                       FontSize="18"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Reports"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsCategoriesSelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Categories">
                        <StackPanel>
                            <TextBlock Text="#"
                                       FontSize="18"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Categories"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsMoreSelected}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="More">
                        <StackPanel>
                            <TextBlock Text="..."
                                       FontSize="18"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="More"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
