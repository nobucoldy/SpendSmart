<Window x:Class="spendsmart.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpendSmart"
        Width="480"
        Height="850"
        MinWidth="480"
        MinHeight="750"
        MaxWidth="480"
        MaxHeight="750"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#5F5F5F" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Margin="2"
                                Padding="4"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#159CE4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F4F7FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0"
                            Content="{Binding CurrentPage}" />

            <Border Grid.Row="1"
                    Padding="8,4,8,5"
                    Background="#FAFAFA"
                    BorderBrush="#D9D9D9"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0">
                <UniformGrid Columns="5">
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsInputSelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Input">
                        <StackPanel>
                            <TextBlock Text="✎"
                                       FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Nhập vào"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsHistorySelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="History">
                        <StackPanel>
                            <TextBlock Text="▤"
                                       FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Lịch"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsReportsSelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Reports">
                        <StackPanel>
                            <TextBlock Text="◔"
                                       FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Báo cáo"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsCategoriesSelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Categories">
                        <StackPanel>
                            <TextBlock Text="▦"
                                       FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Danh mục"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsMoreSelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="More">
                        <StackPanel>
                            <TextBlock Text="⋯"
                                       FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Khác"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
