<UserControl x:Class="spendsmart.Views.InputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#159CE4" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Margin="2"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#159CE4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,8,20,0">
            <TextBlock Text="22:01"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Top" />
            <TextBlock Text="✎"
                       FontSize="30"
                       Foreground="#159CE4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" />
            <Border Width="250"
                    Height="38"
                    Background="#E8E8EA"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Tiền chi"
                                 IsChecked="{Binding IsExpenseSelected, Mode=OneWay}"
                                 Command="{Binding SelectExpenseCommand}"
                                 Style="{StaticResource SegmentButtonStyle}" />
                    <RadioButton Grid.Column="1"
                                 Content="Tiền thu"
                                 IsChecked="{Binding IsIncomeSelected, Mode=OneWay}"
                                 Command="{Binding SelectIncomeCommand}"
                                 Style="{StaticResource SegmentButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border BorderBrush="#DADADA" BorderThickness="0,1,0,1" Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ngày"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                    <DatePicker Grid.Column="1"
                                SelectedDate="{Binding SelectedDate}"
                                Height="38"
                                FontSize="18"
                                Background="#EEF8FE"
                                BorderThickness="0" />
                </Grid>
            </Border>

            <Border BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ghi chú"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             Height="38"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="20"
                             Foreground="#555"
                             VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <Border BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AmountLabel}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Height="44"
                            Background="#EEF8FE"
                            CornerRadius="8">
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="12,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="30"
                                 FontWeight="Bold"
                                 Foreground="#555"
                                 VerticalContentAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="đ"
                               Margin="14,0,0,0"
                               FontSize="24"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Danh mục"
                       Margin="20,22,0,12"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#555" />
            <TextBlock Text="{Binding SelectedCategoryText}"
                       Margin="20,0,20,4"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#159CE4" />
            <TextBlock Text="{Binding StatusMessage}"
                       MinHeight="24"
                       Margin="20,0,20,4"
                       TextWrapping="Wrap"
                       Foreground="#DC2626" />
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="White"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="20,0,20,10">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="White">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#159CE4" />
                                        <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="Root" Property="Background" Value="#F1FAFF" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#F7FBFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="94">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconSymbol}"
                                       FontSize="34"
                                       Foreground="{Binding Color}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       Margin="4,4,4,0"
                                       FontSize="17"
                                       Foreground="#555"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="3"
                Content="{Binding SaveButtonText}"
                Command="{Binding SaveCommand}"
                Margin="24,8,24,18"
                Height="58"
                Background="#159CE4"
                Foreground="White"
                FontSize="24"
                FontWeight="Bold"
                BorderThickness="0" />
    </Grid>
</UserControl>
