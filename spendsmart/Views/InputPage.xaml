<UserControl x:Class="spendsmart.Views.InputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,8,20,0">
            <TextBlock Text="22:01"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Top" />
            <TextBlock Text="✎"
                       FontSize="30"
                       Foreground="#159CE4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" />
            <Border Width="250"
                    Height="38"
                    Background="#E8E8EA"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Margin="2"
                            Background="#159CE4"
                            CornerRadius="10">
                        <TextBlock Text="Tiền chi"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Tiền thu"
                               Foreground="#159CE4"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border BorderBrush="#DADADA" BorderThickness="0,1,0,1" Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ngày ‹"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#555" />
                    <Border Grid.Column="1"
                            Margin="18,0"
                            Background="#EEF8FE"
                            CornerRadius="8"
                            Height="38">
                        <TextBlock Text="19/06/2026 (Thứ 6)"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#555"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="›"
                               FontSize="34"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ghi chú"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#555" />
                    <TextBlock Grid.Column="1"
                               Text="Chưa nhập vào"
                               FontSize="20"
                               Foreground="#CFCFCF" />
                </Grid>
            </Border>

            <Border BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tiền chi"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Height="44"
                            Background="#EEF8FE"
                            CornerRadius="8">
                        <TextBlock Text="0"
                                   Margin="12,0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#555"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="đ"
                               Margin="14,0,0,0"
                               FontSize="24"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Danh mục"
                       Margin="20,24,0,16"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#555" />
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="3" Margin="20,0,20,10">
            <Border Margin="4" BorderBrush="#B8B8B8" BorderThickness="2" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🍽" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Ăn uống" FontSize="18" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🛍" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Chi tiêu hằng..." FontSize="17" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👕" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Quần áo" FontSize="18" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="💄" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Mỹ phẩm" FontSize="18" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🎉" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Mừng" FontSize="18" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="💊" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Y tế" FontSize="18" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📘" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Giáo dục" FontSize="18" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🚰" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Tiền điện" FontSize="18" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🚌" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock Text="Đi lại" FontSize="18" Foreground="#555" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Button Grid.Row="3"
                Content="Nhập khoản chi"
                Margin="24,8,24,18"
                Height="58"
                Background="#159CE4"
                Foreground="White"
                FontSize="24"
                FontWeight="Bold"
                BorderThickness="0" />
    </Grid>
</UserControl>
