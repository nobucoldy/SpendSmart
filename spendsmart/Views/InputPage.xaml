<UserControl x:Class="spendsmart.Views.InputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#159CE4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Margin="2"
                                Background="Transparent"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#159CE4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#159CE4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0F8FD4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0B7FBE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,2,20,0">
            <TextBlock Text="{Binding PageTitle}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#555"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
            <TextBlock Text="✎"
                       FontSize="18"
                       Foreground="#159CE4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <Border Width="210"
                    Height="32"
                    Background="#E8E8EA"
                    CornerRadius="11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="Tiền chi"
                                 IsChecked="{Binding IsExpenseSelected, Mode=OneWay}"
                                 Command="{Binding SelectExpenseCommand}"
                                 Style="{StaticResource SegmentButtonStyle}" />
                    <RadioButton Grid.Column="1"
                                 Content="Tiền thu"
                                 IsChecked="{Binding IsIncomeSelected, Mode=OneWay}"
                                 Command="{Binding SelectIncomeCommand}"
                                 Style="{StaticResource SegmentButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border BorderBrush="#DADADA" BorderThickness="0,1,0,1" Padding="16,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ngày"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="&lt;"
                            Command="{Binding PreviousDateCommand}"
                            Height="30"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="#555"
                            FontSize="16"
                            FontWeight="Bold" />
                    <Grid Grid.Column="2">
                        <ToggleButton x:Name="DateToggle"
                                      Content="{Binding SelectedDateText}"
                                      Height="30"
                                      BorderThickness="0"
                                      Background="#EEF8FE"
                                      Foreground="#555"
                                      FontSize="14"
                                      FontWeight="SemiBold" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=DateToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=DateToggle}"
                               Placement="Bottom"
                               StaysOpen="False">
                            <Border Background="White"
                                    BorderBrush="#DADADA"
                                    BorderThickness="1">
                                <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                          SelectedDatesChanged="DateCalendar_SelectedDatesChanged" />
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Grid.Column="3"
                            Content="&gt;"
                            Command="{Binding NextDateCommand}"
                            Height="30"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="#555"
                            FontSize="16"
                            FontWeight="Bold" />
                </Grid>
            </Border>

            <Border BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="16,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ghi chú"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="255"
                             Height="30"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             Foreground="#555"
                             VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <Border BorderBrush="#E3E3E3" BorderThickness="0,0,0,1" Padding="16,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AmountLabel}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Height="34"
                            Background="#EEF8FE"
                            CornerRadius="8">
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="10,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="20"
                                 FontWeight="Bold"
                                 Foreground="#555"
                                 VerticalContentAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="2"
                               Text="đ"
                               Margin="10,0,0,0"
                               FontSize="16"
                               Foreground="#555"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Danh mục"
                       Margin="16,12,0,6"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#555" />
            <TextBlock Text="{Binding StatusMessage}"
                       MinHeight="18"
                       Margin="16,0,16,2"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#DC2626" />
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="White"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Margin="16,0,16,8">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="136" ItemHeight="78" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Width" Value="128" />
                    <Setter Property="Height" Value="70" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="White">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#159CE4" />
                                        <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="Root" Property="Background" Value="#F1FAFF" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#F7FBFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="128" Height="70">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconSymbol}"
                                       FontSize="23"
                                       Foreground="{Binding Color}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       Margin="4,3,4,0"
                                       FontSize="12"
                                       Foreground="#555"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3"
              Margin="16,6,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Content="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    Height="40"
                    Style="{StaticResource PrimaryActionButtonStyle}" />

            <Button Grid.Column="2"
                    Content="Xóa"
                    Command="{Binding DeleteCommand}"
                    Width="82"
                    Height="40"
                    Background="#F05A3A"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource PrimaryActionButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
