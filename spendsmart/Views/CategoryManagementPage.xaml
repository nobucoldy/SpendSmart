<UserControl x:Class="spendsmart.Views.CategoryManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#159CE4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Margin="2"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#159CE4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconPickerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Height="40"
                                Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#B8B8B8" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorPickerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Outer"
                                Height="30"
                                Background="Transparent"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border Margin="2"
                                    Background="{Binding}"
                                    CornerRadius="4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#555555" />
                                <Setter TargetName="Outer" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid Visibility="{Binding ListVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0,20,0">
                
                <TextBlock Text="Danh mục"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#111111"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Content="+"
                        Command="{Binding OpenCreateCommand}"
                        Width="34"
                        Height="34"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#0A84E9"
                        FontSize="22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="1">
                <Border Margin="24,6,24,6"
                        Height="32"
                        Background="#E8E8EA"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton Content="Tiền chi"
                                     IsChecked="{Binding IsExpenseSelected, Mode=OneWay}"
                                     Command="{Binding SelectExpenseCommand}"
                                     Style="{StaticResource SegmentButtonStyle}" />
                        <RadioButton Grid.Column="1"
                                     Content="Tiền thu"
                                     IsChecked="{Binding IsIncomeSelected, Mode=OneWay}"
                                     Command="{Binding SelectIncomeCommand}"
                                     Style="{StaticResource SegmentButtonStyle}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding StatusMessage}"
                           MinHeight="18"
                           Margin="24,0,24,2"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="#DC2626" />
            </StackPanel>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="White"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="16,0,16,8">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="136" ItemHeight="78" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Width" Value="128" />
                        <Setter Property="Height" Value="70" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root"
                                            BorderBrush="#DADADA"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Background="White">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="#159CE4" />
                                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="Root" Property="Background" Value="#F1FAFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="128" Height="70">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding IconSymbol}"
                                           FontSize="23"
                                           Foreground="{Binding Color}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Name}"
                                           Margin="4,4,4,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#555"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Visibility="{Binding FormVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0,20,0">
                <Button Content="‹"
                        Command="{Binding BackCommand}"
                        Width="34"
                        Height="34"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#0A84E9"
                        FontSize="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding PageTitle}"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#111111"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Content="Xóa"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding DeleteVisibility}"
                        Width="58"
                        Height="30"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#F0533F"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          Background="White">
                <StackPanel>
                    <Border Height="6"
                            BorderBrush="#DADADA"
                            BorderThickness="0,1,0,1"
                            Background="#FAFAFA" />

                    <Border BorderBrush="#DADADA"
                            BorderThickness="0,0,0,1"
                            Padding="16,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tên"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#111111"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"
                                     Foreground="#555555" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Biểu tượng"
                               Margin="16,12,16,8"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#111111" />

                    <ListBox ItemsSource="{Binding IconOptions}"
                             SelectedValue="{Binding IconName, Mode=TwoWay}"
                             SelectedValuePath="IconName"
                             BorderThickness="0"
                             Background="White"
                             Margin="16,0,16,12"
                             ItemContainerStyle="{StaticResource IconPickerItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Symbol}"
                                           FontSize="18"
                                           Foreground="#555555"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border BorderBrush="#E5E5E5"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Màu sắc"
                                       Margin="16,0,16,8"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#111111" />

                            <ListBox ItemsSource="{Binding ColorOptions}"
                                     SelectedItem="{Binding Color, Mode=TwoWay}"
                                     BorderThickness="0"
                                     Background="White"
                                     Margin="16,0,16,4"
                                     ItemContainerStyle="{StaticResource ColorPickerItemStyle}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}"
                               MinHeight="18"
                               Margin="24,2,24,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="#DC2626" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="#E5E5E5"
                    BorderThickness="0,1,0,0"
                    Padding="34,8,34,10"
                    Background="White">
                <Button Content="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        Height="46"
                        Background="#76B4EA"
                        Foreground="White"
                        FontSize="17"
                        FontWeight="Bold"
                        BorderThickness="0" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
