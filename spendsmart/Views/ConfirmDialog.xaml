<Window x:Class="spendsmart.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#DADADA"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.22"
                              Color="#666666" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="32"
                        Height="32"
                        Background="{Binding IconBackground}"
                        CornerRadius="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding IconText}"
                               Foreground="{Binding IconForeground}"
                               FontSize="18"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding TitleText}"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{Binding MessageText}"
                       Margin="0,14,0,18"
                       FontSize="14"
                       Foreground="#666666"
                       LineHeight="20"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding CancelText}"
                        Click="Cancel_Click"
                        Margin="0,0,10,0"
                        Background="#EEF8FE"
                        Foreground="#159CE4"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button Content="{Binding ConfirmText}"
                        Click="Confirm_Click"
                        Background="{Binding ConfirmBackground}"
                        Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
